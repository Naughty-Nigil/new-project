<!DOCTYPE html>
<html>
<head>
    <title>To-Do List</title>

    <style>
        body {
            font-family: Arial;
            background: #eef2ff;
            display: flex;
            justify-content: center;
            padding-top: 60px;
        }

        .app {
            background: white;
            padding: 30px;
            width: 350px;
            border-radius: 15px;
        }

        input {
            padding: 12px;
            width: 220px;
        }

        button {
            padding: 12px;
            cursor: pointer;
        }

        li {
            margin-top: 12px;
            padding: 10px;
            background: #f1f1f1;
            list-style: none;
        }
    </style>
</head>

<body>

<div class="app">
    <h1>📝 My Tasks</h1>

    <input id="task" placeholder="Enter task">
    <button onclick="addTask()">Add</button>

    <ul id="list"></ul>
</div>

<script>
    function addTask() {
        const input = document.getElementById("task");

        if (input.value.trim() === "") return;

        const li = document.createElement("li");

        li.textContent = input.value;
        li.onclick = function() {
            li.style.textDecoration = "line-through";
        };

        document.getElementById("list").appendChild(li);

        input.value = "";
    }
</script>

</body>
</html>
