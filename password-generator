<!DOCTYPE html>
<html>
<head>
    <title>Password Generator</title>

    <style>
        body {
            font-family: Arial;
            background: #1d3557;
            color: white;
            text-align: center;
            padding-top: 100px;
        }

        input {
            padding: 15px;
            width: 300px;
            font-size: 18px;
        }

        button {
            padding: 15px 20px;
            margin: 10px;
            cursor: pointer;
        }
    </style>
</head>

<body>

<h1>🔐 Password Generator</h1>

<input id="password" readonly>

<br>

<button onclick="generatePassword()">
    Generate Password
</button>

<script>
    function generatePassword() {

        const characters =
            "ABCDEFGHIJKLMNOPQRSTUVWXYZ" +
            "abcdefghijklmnopqrstuvwxyz" +
            "0123456789!@#$%^&*";

        let password = "";

        for (let i = 0; i < 14; i++) {
            password += characters[
                Math.floor(Math.random() * characters.length)
            ];
        }

        document.getElementById("password").value = password;
    }
</script>

</body>
</html>
