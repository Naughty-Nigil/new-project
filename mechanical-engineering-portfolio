    <p>
        I am a Mechanical Engineering student interested in
        machine design, manufacturing, thermal engineering
        and engineering software.
    </p>

</section>

<section>

    <h2>🛠️ Skills</h2>

    <div class="skills">
        <div class="skill">AutoCAD</div>
        <div class="skill">SolidWorks</div>
        <div class="skill">ANSYS</div>
        <div class="skill">CAD Design</div>
        <div class="skill">Manufacturing</div>
        <div class="skill">Python</div>
    </div>

</section>

<section>

    <h2>🚀 Projects</h2>

