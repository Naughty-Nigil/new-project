        }

        .skill {
            background: #f39c12;
            color: black;
            padding: 12px 20px;
            border-radius: 20px;
        }

        .project {
            background: #1f2d3a;
            padding: 20px;
            margin: 15px 0;
            border-left: 5px solid #f39c12;
        }

        footer {
            text-align: center;
            padding: 30px;
            background: #1f2d3a;
